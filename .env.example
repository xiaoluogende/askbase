# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交
#
# ⚠️ 下面所有值都是「本地开发用」的弱口令。
#    任何真实部署都必须换掉，尤其是 JWT_SECRET。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123
DB_HOST=localhost
DB_PORT=3307
DB_NAME=askbase
DB_USER=askbase
DB_PASSWORD=askbase123

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 应用认证 ----
# HS256 要求至少 32 字节。生成方式：openssl rand -base64 48
JWT_SECRET=dev-only-secret-please-change-me-0123456789abcdef
# 开发用户密码（用户名固定 admin）
DEV_ADMIN_PASSWORD=admin123

# ---- 大模型 API（不填也能启动，只是没有问答能力）----
# 阿里云百炼（通义千问）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
