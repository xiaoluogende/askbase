# 生产环境配置模板
#
#   cp .env.prod.example .env.prod
#   然后逐项填写。.env.prod 已在 .gitignore 里（.env* 规则），不会被提交。
#
# 生成随机密码：
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
#
# ⚠️ 所有标了「必须改」的项，用默认值上线等于把服务器送人。

# ---- MySQL ----
# 必须改：root 密码。容器不会对公网开放，但弱口令仍然危险
MYSQL_ROOT_PASSWORD=
# 应用读写账号
DB_USER=askbase
DB_PASSWORD=
# 只读账号：执行模型生成的 SQL 用，只能 SELECT
DB_RO_USER=askbase_ro
DB_RO_PASSWORD=

# ---- Redis ----
# 必须改：不设密码等于没锁门（见 docker-compose.prod.yml 的说明）
REDIS_PASSWORD=

# ---- 应用认证 ----
# 必须改：HS256 要求至少 32 字节
#   openssl rand -base64 48
JWT_SECRET=
# 必须改：管理员登录密码
DEV_ADMIN_PASSWORD=

# ---- 大模型 API ----
# 不填也能启动，但问答功能不可用
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
