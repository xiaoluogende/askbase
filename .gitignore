# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
*.swp

# ---- 环境变量与密钥（最重要的一条，删了会出事）----
# 用通配符而不是逐个列举：只写 .env 的话，.env.bak / .env.prod / .env.old
# 这些"备份出来的"文件会被正常提交，而它们往往就带着真 Key。
.env
.env.*
# 例外：示例文件必须提交，里面只有空的占位符
!.env.example
!.env.prod.example
*.pem
*.key
application-local.yml
application-secret.yml

# ---- 私有工作笔记（不入库）----
# 立项理由、面试预演、求职策略、环境清单、排期计划等
# 属于个人准备材料，不随项目发布
notes/

# ---- 运行时产物 ----
logs/
*.log
*.hprof
dump.*

# ---- 系统 ----
.DS_Store
Thumbs.db
